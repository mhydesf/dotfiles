/* Spotlight-glass (dark, transparent, refined) */

* {
  font: "Inter 11";

  /* glass */
  bg:        #0b0d12b8;   /* window glass */
  panel:     #121724c2;   /* search pill */
  stroke:    #ffffff12;   /* hairline stroke */
  shadow:    #00000055;

  /* text */
  fg:        #f4f6fb;
  fg-muted:  #cbd3e1;
  fg-dim:    #a8b1c4;

  /* selection */
  sel-bg:    #ffffff14;   /* subtle highlight, not white */
  sel-fg:    #ffffff;

  spacing: 10;
}

/***** WINDOW *****/
window {
  location: center;
  anchor: center;

  width: 640px;

  /* remove the “thick black border” */
  border: 0;
  padding: 14px;
  border-radius: 18px;

  background-color: @bg;
}

/* ensure nothing else reintroduces a border */
mainbox {
  border: 0;
  padding: 0;
  spacing: 12px;
  background-color: transparent;
}

/***** INPUT PILL *****/
inputbar {
  border: 1px;
  border-color: @stroke;

  border-radius: 14px;
  padding: 10px 12px;
  spacing: 10px;

  background-color: @panel;
  text-color: @fg;

  children: [ prompt, entry ];
}

prompt {
  enabled: true;
  str: ""; /* magnifier (Nerd Font) */
  text-color: @fg-dim;
}

entry {
  background-color: transparent;
  text-color: @fg;
  placeholder: "Search";
  placeholder-color: @fg-dim;
}

/***** LIST (this is where the “shitty white” usually leaks in) *****/
listview {
  border: 0;
  padding: 2px;
  spacing: 6px;
  lines: 8;
  fixed-height: true;
  scrollbar: false;

  background-color: transparent;
}

/* belt-and-suspenders: nuke any leftover white surfaces */
message, textbox, scrollbar, mode-switcher, button {
  background-color: transparent;
  border: 0;
}

/***** ROWS *****/
element {
  border: 0;
  padding: 9px 10px;
  border-radius: 12px;

  /* IMPORTANT: keep rows transparent so the window glass shows through */
  background-color: transparent;
  text-color: @fg-muted;
}

element-icon {
  size: 1.1em;
  vertical-align: 0.5;
  margin: 0px 8px 0px 2px;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

/* Explicitly define ALL states so nothing falls back to a white default */
element.normal.normal,
element.normal.active,
element.normal.urgent,
element.alternate.normal,
element.alternate.active,
element.alternate.urgent {
  background-color: transparent;
  text-color: @fg-muted;
}

/* Selection: subtle translucent highlight with visible text */
element.selected.normal,
element.selected.active,
element.selected.urgent {
  background-color: @sel-bg;
  text-color: @sel-fg;
}

/* Optional: make active slightly brighter without changing bg */
element.normal.active,
element.alternate.active {
  text-color: @fg;
}

/* --- ICON TRANSPARENCY FIX --- */

/* Icon widget itself */
element-icon {
  background-color: transparent;
  text-color: inherit;
  size: 1.1em;
  vertical-align: 0.5;
}

/* Force transparency across ALL element states */
element-icon.normal,
element-icon.active,
element-icon.urgent,
element-icon.selected,
element-icon.alternate {
  background-color: transparent;
}

/* Also kill background inheritance from parent elements */
element,
element-text,
element-icon {
  background-color: transparent;
}

/* GTK icon fallback surfaces sometimes paint white */
* {
  icon-theme: "Papirus-Dark"; /* or any dark icon theme you use */
}
