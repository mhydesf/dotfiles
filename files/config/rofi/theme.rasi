/* Unified Kitty + Hyprland Lavender */

/***** GLOBAL *****/
* {
  font: "FiraMono Nerd Font 11";

  /* surfaces */
  bg:        #000000f2;
  panel:     #0b0b0bfa;
  stroke:    #2b2b2bff;
  shadow:    #000000aa;

  /* text */
  fg:        #e9e9e9ff;
  fg-muted:  #bcbcbc;
  fg-dim:    #8f8f8f;

  /* selection */
  sel-bg:    #424242cc;
  sel-fg:    #e9e9e9ff;

  spacing: 10;

  icon-theme: "Papirus-Dark";
}

/***** WINDOW *****/
window {
  location: west;
  anchor:   west;

  width: 420px;
  height: 100%;

  border: 2;
  padding: 18px;
  border-radius: 5px;

  background-color: @bg;
}

/* ensure nothing else reintroduces a border */
mainbox {
  border: 0;
  padding: 0;
  spacing: 12px;
  background-color: transparent;
}

/***** INPUT PILL *****/
inputbar {
  border: 1px;
  border-color: #9a90b8ff; /* Hypr active lavender */

  border-radius: 14px;
  padding: 10px 12px;
  spacing: 10px;

  background-color: @panel;
  text-color: @fg;

  children: [ prompt, entry ];
}

prompt {
  enabled: true;
  str: "";
  text-color: @fg-dim;
}

entry {
  background-color: transparent;
  text-color: @fg;
  placeholder: "Search";
  placeholder-color: @fg-dim;
}

/***** LIST *****/
listview {
  border: 0;
  padding: 2px;
  spacing: 6px;

  lines: 20;
  fixed-height: false;
  scrollbar: false;

  background-color: transparent;
}

/* nuke all fallback surfaces */
message,
textbox,
scrollbar,
mode-switcher,
button {
  background-color: transparent;
  border: 0;
}

/***** ROWS *****/
element {
  border: 0;
  padding: 9px 10px;
  border-radius: 12px;

  background-color: transparent;
  text-color: @fg-muted;
}

element-icon {
  size: 1.1em;
  vertical-align: 0.5;
  margin: 0px 8px 0px 2px;
  background-color: transparent;
  text-color: inherit;
}

element-text {
  background-color: transparent;
  text-color: inherit;
}

/* Explicitly define ALL states */
element.normal.normal,
element.normal.active,
element.normal.urgent,
element.alternate.normal,
element.alternate.active,
element.alternate.urgent {
  background-color: transparent;
  text-color: @fg-muted;
}

/* Selection */
element.selected.normal,
element.selected.active,
element.selected.urgent {
  background-color: @sel-bg;
  text-color: @sel-fg;
}

/* Active row slightly brighter */
element.normal.active,
element.alternate.active {
  text-color: @fg;
}

/***** ICON TRANSPARENCY FIX *****/
element-icon.normal,
element-icon.active,
element-icon.urgent,
element-icon.selected,
element-icon.alternate {
  background-color: transparent;
}

/* Kill GTK fallback inheritance */
element,
element-text,
element-icon {
  background-color: transparent;
}

