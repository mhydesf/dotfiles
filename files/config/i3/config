# Use Super/Windows key as $mod
set $mod Mod1

# Terminal
set $terminal ~/.local/bin/kitty
bindsym $mod+Return exec $terminal

# Reload / Restart / Exit i3
bindsym $mod+Ctrl+l exec --no-startup-id i3lock -c 000000
bindsym $mod+Ctrl+r restart
bindsym $mod+Ctrl+c reload
bindsym $mod+Ctrl+e exec "i3-nagbar -t warning -m 'Exit i3?' -b 'Yes' 'i3-msg exit'"
bindsym $mod+q kill

# Application launcher
bindsym $mod+space exec --no-startup-id rofi -show drun

# Window focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Focus/move to output
bindsym $mod+Left focus output left
bindsym $mod+Right focus output right
bindsym $mod+Shift+Left move window to output left
bindsym $mod+Shift+Right move window to output right

# Split containers
bindsym $mod+v split v
bindsym $mod+b split h

# Fullscreen
bindsym $mod+f fullscreen toggle

# Focus parent/child
bindsym $mod+a focus parent

# Workspaces
set $ws1 "Teams"
set $ws2 "Chrome"
set $ws3 "Term"
set $ws4 "Music"

# Switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4

# Assign applications to workspaces
assign [class="YouTube Music Desktop App"] $ws4
assign [class="Google-chrome" instance="crx_ckdeglopgbdgpkmhnmkigpfgebcdbanf"] $ws1
assign [class="Google-chrome" instance="crx_famdcdojlmjefmhdpbpmekhodagkodei"] $ws1

# Media keys
bindsym XF86AudioMute         exec --no-startup-id pactl set-sink-mute   @DEFAULT_SINK@ toggle
bindsym XF86AudioLowerVolume  exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioRaiseVolume  exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioMicMute      exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86KbdBrightnessDown exec --no-startup-id brightnessctl -d kbd_backlight set 5%-
bindsym XF86KbdBrightnessUp   exec --no-startup-id brightnessctl -d kbd_backlight set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -d intel_backlight set 5%-
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl -d intel_backlight set +5%
bindsym XF86AudioPlay         exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext         exec --no-startup-id playerctl next
bindsym XF86AudioPrev         exec --no-startup-id playerctl previous
bindsym XF86AudioStop         exec --no-startup-id playerctl stop

bindsym $mod+P                exec --no-startup-id playerctl play-pause

# Bluetooth audio mode toggle
bindsym $mod+s exec --no-startup-id ~/.shell/bt_switch.sh

# App launchers
bindsym $mod+Shift+b exec --no-startup-id google-chrome --disable-extensions
bindsym $mod+Shift+m exec --no-startup-id youtube-music-desktop-app

# Screenshots
bindsym Print exec --no-startup-id flameshot gui
bindsym Shift+Print exec --no-startup-id flameshot full -p "$HOME/Pictures/Screenshots"
bindsym Ctrl+Print exec --no-startup-id flameshot gui --region window

# Suspend
bindsym $mod+z exec --no-startup-id systemctl suspend

# Resize mode
mode "resize" {
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Window borders and Syle
for_window [class=".*"] border pixel 2
default_floating_border pixel 2

client.focused          #7E768D #1A1A1A #FFFFFF #7E768D #7E768D
client.focused_inactive #6B6579 #1A1A1A #CCCCCC #6B6579 #6B6579
client.unfocused        #2B2B2B #1A1A1A #888888 #2B2B2B #2B2B2B
client.urgent           #B66A6A #1A1A1A #FFFFFF #B66A6A #B66A6A

# Startup applications
exec_always --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -c 000000
exec_always --no-startup-id nvidia-settings -a [gpu:0]/GPULogoBrightness=0 >/dev/null 2>&1
exec_always --no-startup-id nvidia-settings -a AllowFlipping=1
exec_always --no-startup-id nvidia-settings -a ForceFullCompositionPipeline=0

exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id autorandr --change

exec_always --no-startup-id blueman-applet
exec_always --no-startup-id nm-applet

exec_always --no-startup-id feh --bg-fill ~/Pictures/Wallpapers/3840x1600/sunset.jpg
exec_always --no-startup-id ~/.config/i3/setup-inputs.sh
exec_always --no-startup-id ~/.config/i3/polybar.sh
