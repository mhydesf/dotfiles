{
  "reload_style_on_change": true,
  "layer": "bottom",
  "position": "bottom",
  "height": 30,
  "spacing": 10,

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/cpu",
    "custom/memory",
    "bluetooth",
    "network",
    "pulseaudio",
    "pulseaudio/slider",
    "battery",
    "tray",
    "custom/notifications"
  ],

  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󱅫",
      "dnd-none": "󰂛"
    },
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -C",
    "tooltip": false,
    "restart-interval": 5
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": { "*": 8 },
    "format": "{icon}",
    "format-icons": {
      "1": "󰭹",
      "2": "",
      "3": "",
      "4": "󰗃",
      "5": "󰸶",
      "default": ""
    }
  },

  "clock": {
    "format": "{:%a %d %b  %I:%M %p}",
    "tooltip": false
  },

  "custom/memory": {
    "exec": "~/.config/waybar/scripts/mem_spark.sh",
    "interval": 2,
    "return-type": "json",
    "tooltip": true,
    "on-click": "~/.local/bin/launch-tui btop"
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu_spark.sh",
    "interval": 2,
    "return-type": "json",
    "tooltip": true,
    "on-click": "~/.local/bin/launch-tui btop"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "~/.local/bin/launch-tui bluetui"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{ifname}\n{essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
    "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}",
    "interval": 5,
    "on-click": "~/.local/bin/launch-impala"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
    "scroll-step": 2,
    "on-click": "~/.local/bin/launch-tui wiremix"
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "interval": 10
  },

  "tray": {
    "icon-size": 12,
    "spacing": 8
  }
}
