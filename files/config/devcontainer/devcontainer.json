{
    "updateRemoteUserUID": true,
    "capAdd": [
        "SYS_PTRACE",
        "NET_ADMIN",
        "NET_RAW"
    ],
    "securityOpt": [
        "seccomp=unconfined"
    ],
    "runArgs": [
        "--init",
        "--network=host"
    ],
    "containerEnv": {
        "TERM": "xterm-256color",
        "COLORTERM": "truecolor",
        "LANG": "en_US.UTF-8",
        "LANGUAGE": "en_US:en",
        "LC_ALL": "en_US.UTF-8",
        "EDITOR": "nvim",
        "VISUAL": "nvim",
        "XDG_RUNTIME_DIR": "/run/user/1000",
        "DISPLAY": "${localEnv:DISPLAY}",
        "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}"
    },
    "mounts": [
        "source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=/run/user/1000/${localEnv:WAYLAND_DISPLAY},type=bind",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
        "source=${localEnv:HOME}/.ssh,target=/home/__USERNAME__/.ssh,type=bind",
        "source=${localEnv:HOME}/.gitconfig,target=/home/__USERNAME__/.gitconfig,type=bind",
        "source=${localEnv:HOME}/.config/nvim,target=/home/__USERNAME__/.config/nvim,type=bind",
        "source=${localEnv:HOME}/.tmux.conf,target=/home/__USERNAME__/.tmux.conf,type=bind",
        "source=${localEnv:HOME}/.bash_aliases,target=/home/__USERNAME__/.bash_aliases,type=bind"
    ],
    "postCreateCommand": "sudo chown -R __USERNAME__:__USERNAME__ /home/__USERNAME__/.local /home/__USERNAME__/.cache /run/user/1000 && chmod 0700 /run/user/1000"
}
