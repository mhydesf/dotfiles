ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG USERNAME=base
ARG USER_UID=1000
ARG USER_GID=1000

USER root

# 1. Copy prebuilt personal tools from personal-base-dev:latest into isolated /opt/personal
COPY --from=personal-base-dev:latest /opt/personal/ /opt/personal/

# Expose personal CLI tools without clobbering existing project toolchains in /usr/local
RUN mkdir -p /usr/local/bin                                                                 \
    && for tool in nvim zoxide tree-sitter markdown-toc neovim-node-host; do                \
        if [ -x "/opt/personal/bin/${tool}" ]; then                                         \
            ln -sf "/opt/personal/bin/${tool}" "/usr/local/bin/${tool}";                    \
        fi;                                                                                 \
    done                                                                                    \
    && for tool in node npm npx; do                                                         \
        if ! command -v "${tool}" >/dev/null 2>&1 && [ -x "/opt/personal/node/bin/${tool}" ]; then \
            ln -sf "/opt/personal/node/bin/${tool}" "/usr/local/bin/${tool}";               \
        fi;                                                                                 \
    done                                                                                    \
    && if ! command -v uv >/dev/null 2>&1 && [ -x /opt/personal/uv/bin/uv ]; then           \
        ln -sf /opt/personal/uv/bin/uv /usr/local/bin/uv;                                   \
    fi                                                                                      \
    && if ! command -v python3 >/dev/null 2>&1 && [ -x /opt/personal/python-bin/python3.13 ]; then \
        ln -sf /opt/personal/python-bin/python3.13 /usr/local/bin/python3;                  \
    fi

# 2. Install personal interactive CLI, Tmux, search, clipboard & LSP packages
# If a base image ships with all apt sources commented out, re-enable one so overlay packages can install.
RUN if ! grep -rqE '^[[:space:]]*deb[[:space:]]' /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null \
    && ! grep -rqE '^[[:space:]]*Types:' /etc/apt/sources.list.d/*.sources 2>/dev/null; then \
        for f in /etc/apt/sources.list.d/*.list /etc/apt/sources.list; do                    \
            if [ -f "$f" ] && grep -qE '^[[:space:]]*#[[:space:]]*deb[[:space:]]' "$f"; then \
                sed -i -E '/^[[:space:]]*#[[:space:]]*deb[[:space:]]/ s/^[[:space:]]*#[[:space:]]*//' "$f"; \
                break;                                                                      \
            fi;                                                                             \
        done;                                                                               \
    fi                                                                                      \
    && apt-get update                                                                       \
    && EXTRA_PKGS=""                                                                        \
    && for pkg in clang clang-format clang-tidy lld lldb; do                                \
        if ! command -v "${pkg}" >/dev/null 2>&1; then                                      \
            EXTRA_PKGS="${EXTRA_PKGS} ${pkg}";                                              \
        fi;                                                                                 \
    done                                                                                    \
    && apt-get install -y --no-install-recommends                                           \
        bash-completion                                                                     \
        btop                                                                                \
        ca-certificates                                                                     \
        clangd                                                                              \
        curl                                                                                \
        fd-find                                                                             \
        file                                                                                \
        fzf                                                                                 \
        gdb                                                                                 \
        git                                                                                 \
        htop                                                                                \
        iproute2                                                                            \
        iputils-ping                                                                        \
        jq                                                                                  \
        keychain                                                                            \
        kitty-terminfo                                                                      \
        less                                                                                \
        liblua5.1-0-dev                                                                     \
        locales                                                                             \
        ltrace                                                                              \
        lua5.1                                                                              \
        luajit                                                                              \
        luarocks                                                                            \
        netcat-openbsd                                                                      \
        openssh-client                                                                      \
        procps                                                                              \
        python3                                                                             \
        python3-dev                                                                         \
        python3-pip                                                                         \
        python3-venv                                                                        \
        ripgrep                                                                             \
        strace                                                                              \
        sudo                                                                                \
        tcpdump                                                                             \
        tmux                                                                                \
        tree                                                                                \
        unzip                                                                               \
        wl-clipboard                                                                        \
        xclip                                                                               \
        xsel                                                                                \
        xz-utils                                                                            \
        zip                                                                                 \
        ${EXTRA_PKGS}                                                                       \
    && locale-gen en_US.UTF-8                                                               \
    && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8                                    \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd                                             \
    && rm -rf /var/lib/apt/lists/*

# 3. Ensure target user exists with passwordless sudo
RUN if ! id -u "${USERNAME}" >/dev/null 2>&1; then                          \
        existing_user="$(getent passwd "${USER_UID}" | cut -d: -f1 || true)"; \
        if [ -n "${existing_user}" ]; then                                  \
            groupmod -n "${USERNAME}" "${existing_user}" 2>/dev/null || true; \
            usermod -l "${USERNAME}" -d "/home/${USERNAME}" -m "${existing_user}"; \
        else                                                                \
            groupadd --gid "${USER_GID}" "${USERNAME}" 2>/dev/null || true; \
            useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash "${USERNAME}"; \
        fi;                                                                 \
    fi                                                                      \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
    && chmod 0440 "/etc/sudoers.d/${USERNAME}"

# 4. Prepare Neovim, Tmux (TPM), & personal .bashrc in /etc/skel and /home/${USERNAME}
RUN mkdir -p                                                            \
        /etc/skel/.config/nvim                                          \
        /etc/skel/.local/bin                                            \
        /etc/skel/.local/share/nvim                                     \
        /etc/skel/.local/state/nvim                                     \
        /etc/skel/.cache/nvim                                           \
        /etc/skel/.vim/undodir                                          \
        /etc/skel/.tmux/plugins                                         \
        /home/${USERNAME}/.config/nvim                                  \
        /home/${USERNAME}/.local/bin                                    \
        /home/${USERNAME}/.local/share/nvim                             \
        /home/${USERNAME}/.local/state/nvim                             \
        /home/${USERNAME}/.cache/nvim                                   \
        /home/${USERNAME}/.vim/undodir                                  \
        /home/${USERNAME}/.tmux/plugins                                 \
        /home/${USERNAME}/.ssh                                          \
    && if [ ! -d /etc/skel/.tmux/plugins/tpm ]; then                    \
        git clone --depth 1                                             \
            https://github.com/tmux-plugins/tpm.git                     \
            /etc/skel/.tmux/plugins/tpm;                                \
    fi                                                                  \
    && if [ ! -d "/home/${USERNAME}/.tmux/plugins/tpm" ]; then          \
        cp -a /etc/skel/.tmux/plugins/tpm "/home/${USERNAME}/.tmux/plugins/tpm"; \
    fi                                                                  \
    && if [ ! -f "/home/${USERNAME}/.profile" ] && [ -f /etc/skel/.profile ]; then \
        cp /etc/skel/.profile "/home/${USERNAME}/.profile";             \
    fi                                                                  \
    && chmod 0700 "/home/${USERNAME}/.ssh"

COPY resources/bashrc /etc/skel/.bashrc
COPY resources/bashrc /home/${USERNAME}/.bashrc

RUN target_uid="$(id -u "${USERNAME}")"                                 \
    && target_gid="$(id -g "${USERNAME}")"                              \
    && chown -R "${target_uid}:${target_gid}" "/home/${USERNAME}"

USER ${USERNAME}
